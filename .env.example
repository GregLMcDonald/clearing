# Copy to .env (git-ignored) and fill in. Used only by `npm run audio`;
# the key never reaches the app or the browser.
ELEVENLABS_API_KEY=
# One voice per language. Browse voices at https://elevenlabs.io/app/voice-library
# and paste the IDs here.
# English: falls back to ELEVENLABS_VOICE_ID, then to "Sarah" (EXAVITQu4vr4xnSDxMaL), a premade voice.
ELEVENLABS_VOICE_ID_EN=
# Québec French: French clips are skipped (device voice is used) until this is set.
ELEVENLABS_VOICE_ID_FR=enzbGixeo55iqn1QxbbC
# Optional model overrides.
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2
# ELEVENLABS_MUSIC_MODEL=music_v1
